    "matrix-dom": "github:jheagle/matrix-DOM",
    "si-funciona": "^2.8.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-throw-expressions": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "clean-jsdoc-theme": "^4.3.3",
    "gulp": "^5.0.1",
    "gulp-imagemin": "github:jheagle/gulp-imagemin#common-js-compatibility",
    "js-build-tools": "^6.6.0",
    "jsdoc": "^4.0.5",
    "release-it": "^21.1.1",
    "test-filesystem": "^2.0.2"
  },
  "allowScripts": {
