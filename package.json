{
  "name": "task-manager",
  "version": "0.1.0",
  "description": "A simple storage, retrieval, sorting and prioritizing system for tasks. Partner with people or AI agents.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "lint": "gulp lint",
    "readme": "gulp readme",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "sass": "gulp sass",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/task-manager.git"
  },
  "keywords": [
    "task",
