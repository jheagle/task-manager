    "priority",
    "agents"
  ],
  "author": "Joshua Heagle <joshuaheagle@gmail.com>",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/jheagle/task-manager/issues"
  },
  "homepage": "https://github.com/jheagle/task-manager#readme",
  "peerDependencies": {
    "gulp-imagemin": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "gulp-imagemin": {
      "optional": true
    }
  },
  "standard": {
